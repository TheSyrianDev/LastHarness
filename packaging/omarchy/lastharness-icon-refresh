#!/bin/bash
# Regenerate the transparent, theme-coloured LastHarness launcher icon.
set -euo pipefail
colors=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme/colors.toml
[[ -f $colors ]] || colors=/dev/null  # off Omarchy: the default colours below
icons=${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor
get() { sed -n "s/^$1[[:space:]]*=[[:space:]]*\"\(#[0-9a-fA-F]\{6\}\)\".*/\1/p" "$colors" | head -1; }
fg=$(get foreground); bg=$(get background); accent=$(get accent)
: "${fg:=#b2c27c}" "${bg:=#15251c}" "${accent:=#e0a050}"
lum() { local h=${1#\#} r g b; r=$((16#${h:0:2})); g=$((16#${h:2:2})); b=$((16#${h:4:2})); echo $(( 299*r + 587*g + 114*b )); }
# Eye: theme background, unless it is too close to the face; then the darker of bg/fg-opposite.
eye=$bg
d=$(( $(lum "$fg") - $(lum "$bg") )); d=${d#-}
if (( d < 60000 )); then
  if (( $(lum "$bg") < 128000 )); then eye=#000000; else eye=#ffffff; fi
fi
svg=$icons/scalable/apps/lastharness.svg
mkdir -p "$(dirname "$svg")"
cat > "$svg" <<SVG
<svg xmlns="http://www.w3.org/2000/svg" viewBox="6 7 51 51" width="512" height="512"><rect x="8" y="18" width="38" height="38" rx="15" fill="$fg"/><g transform="translate(2.4 -2) rotate(-8 27 37)"><rect x="18.6" y="30.6" width="6" height="11" rx="3" fill="$eye"/><rect x="30.1" y="31.4" width="4.6" height="10.2" rx="2.3" fill="$eye"/></g><circle cx="49" cy="15" r="6" fill="$accent"/></svg>
SVG
for s in 16 22 24 32 48 64 128 256 512; do
  d=$icons/${s}x${s}/apps; [[ -d $d ]] || continue
  rsvg-convert -w "$s" -h "$s" "$svg" -o "$d/lastharness.png"
done
[[ -d $icons/256x256@2 ]] && rsvg-convert -w 512 -h 512 "$svg" -o "$icons/256x256@2/apps/lastharness.png" 2>/dev/null || true
command -v gtk-update-icon-cache >/dev/null && gtk-update-icon-cache -f -t "$icons" || true
